<h1>{{ site.title }}</h1>
<p class="intro">{{ site.description }}</p>

<div class="section-title">Latest articles</div>
<div class="list">
  {% for post in collections.articles %}
    <div class="item">
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <div class="date">{{ post.date | readableDate }}</div>
    </div>
  {% endfor %}
</div>

