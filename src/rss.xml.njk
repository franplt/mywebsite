---
permalink: /rss.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>{{ site.title }} — Articles</title>
    <link>{{ site.url }}/articles/</link>
    <description>{{ site.description }}</description>
    <language>en</language>
    {% if collections.articles and collections.articles.length %}
    <lastBuildDate>{{ collections.articles[0].date | rfc822Date }}</lastBuildDate>
    {% endif %}
    {% for post in collections.articles %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid>{{ site.url }}{{ post.url }}</guid>
      <pubDate>{{ post.date | rfc822Date }}</pubDate>
      <description>{{ post.data.description or "" }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>

